FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

COPY tests/e2e/package.json tests/e2e/package-lock.json* ./

RUN npm ci

RUN npx playwright install chromium --with-deps

COPY tests/e2e/ ./

CMD ["npx", "playwright", "test", "--reporter=list"]
